# ============================================================
# JudgeAI 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================================

# [必需] 阿里云 DashScope API 密钥
# 用于调用 Qwen 等大语言模型进行 AI 评语生成
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# [必需] JWT 令牌签名密钥
# 用于用户认证和会话安全，请使用高强度随机字符串
# 可通过 python -c "import secrets; print(secrets.token_hex(32))" 生成
JWT_SECRET_KEY=your_jwt_secret_key_here

# [可选] 管理员账户用户名
# 系统初始化时创建的管理员账号，默认 admin
ADMIN_USERNAME=admin

# [可选] 管理员账户密码
# 系统初始化时创建的管理员密码，默认 admin123
# 生产环境请务必修改为强密码
ADMIN_PASSWORD=admin123

# [可选] 管理员邮箱地址
# 用于接收系统通知和密码重置，默认 admin@example.com
ADMIN_EMAIL=admin@example.com

# [可选] Flask 运行环境
# 可选值: production / development / testing
FLASK_ENV=production

# [可选] Flask 调试模式
# 开发时设为 true 可启用热重载和详细错误信息，生产环境必须设为 false
FLASK_DEBUG=false
